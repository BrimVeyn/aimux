{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["fzf", "vhs"],
  "ignoreDependencies": ["bun-types"],
  "rules": {
    "duplicates": "off"
  },
  "workspaces": {
    ".": {
      "entry": [
        "src/restart-daemon.ts",
        "src/restart-terminal-manager.ts",
        "src/daemon/**/*.{ts,tsx}",
        "src/terminal-manager/**/*.{ts,tsx}",
        "test/**/*.{ts,tsx}",
        "examples/**/*.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}", "examples/**/*.{ts,tsx}"]
    },
    "packages/aimux-config": {
      "project": ["src/**/*.ts"]
    },
    "packages/aimux-plugin": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@opentui/core", "@opentui/react"]
    }
  }
}
