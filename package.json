{
  "name": "@brimveyn/aimux",
  "version": "1.16.1",
  "description": "A terminal multiplexer for AI CLIs. Run Claude, Codex, OpenCode side-by-side with tabbed navigation, split panes, and persistent sessions.",
  "keywords": [
    "ai",
    "aimux",
    "bun",
    "claude",
    "cli",
    "codex",
    "multiplexer",
    "opencode",
    "pty",
    "terminal",
    "tui"
  ],
  "homepage": "https://github.com/BrimVeyn/aimux#readme",
  "bugs": {
    "url": "https://github.com/BrimVeyn/aimux/issues"
  },
  "license": "MIT",
  "author": "BrimVeyn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrimVeyn/aimux.git"
  },
  "bin": {
    "aimux": "src/index.tsx"
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "module": "src/index.tsx",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "AIMUX_PROFILE=dev bun --watch src/index.tsx",
    "start": "AIMUX_PROFILE=dev bun run src/index.tsx",
    "test": "bun test",
    "check": "tsc --noEmit",
    "demo": "vhs assets/demo.tape",
    "demo:sessions": "vhs assets/sessions.tape",
    "demo:tabs": "vhs assets/tabs.tape",
    "demo:splits": "vhs assets/splits.tape",
    "demo:themes": "vhs assets/themes.tape",
    "restart-daemon": "AIMUX_PROFILE=dev bun run src/index.tsx restart-daemon",
    "restart-terminal-manager": "AIMUX_PROFILE=dev bun run src/index.tsx restart-terminal-manager",
    "lint": "oxlint --type-aware .",
    "lint:protocol": "bun run scripts/check-protocol-discipline.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "knip": "knip-bun",
    "bump": "bun run scripts/bump.ts",
    "bump:ipc": "bun run scripts/bump-protocol.ts ipc",
    "bump:terminal_manager": "bun run scripts/bump-protocol.ts terminal-manager"
  },
  "dependencies": {
    "@brimveyn/aimux-config": "workspace:*",
    "@opentui/core": "^0.1.90",
    "@opentui/react": "^0.1.90",
    "@resvg/resvg-wasm": "^2.6.2",
    "@xterm/headless": "^6.0.0",
    "bun-pty": "^0.4.8",
    "react": "^19.2.4",
    "shiki": "^4.0.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "eslint-plugin-perfectionist": "^5.8.0",
    "knip": "^6.4.1",
    "lefthook": "^2.1.4",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "oxlint-tsgolint": "^0.23.0",
    "typescript": "^6.0.2"
  }
}
