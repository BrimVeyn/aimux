{
  "name": "@brimveyn/aimux",
  "version": "1.28.4",
  "description": "A terminal multiplexer for AI CLIs. Run Claude, Codex, OpenCode, Kimi side-by-side with tabbed navigation, split panes, and persistent sessions.",
  "keywords": [
    "ai",
    "aimux",
    "bun",
    "claude",
    "cli",
    "codex",
    "kimi",
    "multiplexer",
    "opencode",
    "pty",
    "terminal",
    "tui"
  ],
  "homepage": "https://github.com/BrimVeyn/aimux#readme",
  "bugs": {
    "url": "https://github.com/BrimVeyn/aimux/issues"
  },
  "license": "MIT",
  "author": "BrimVeyn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrimVeyn/aimux.git"
  },
  "bin": {
    "aimux": "src/index.tsx"
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "src",
    "skills",
    "assets/claude-hooks",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "module": "src/index.tsx",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "AIMUX_PROFILE=dev bun --watch src/index.tsx",
    "start": "AIMUX_PROFILE=dev bun run src/index.tsx",
    "test": "bun test",
    "check": "tsc --noEmit",
    "demo": "bash assets/demo-setup.sh && vhs assets/demo.tape",
    "restart-daemon": "AIMUX_PROFILE=dev bun run src/index.tsx restart-daemon",
    "restart-terminal-manager": "AIMUX_PROFILE=dev bun run src/index.tsx restart-terminal-manager",
    "reexec-test": "AIMUX_PROFILE=reexec-test AIMUX_HOT_REEXEC=1 bun run scripts/manual-reexec-test.ts",
    "lint": "oxlint --type-aware .",
    "lint:protocol": "bun run scripts/check-protocol-discipline.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "knip": "knip-bun",
    "docs:plugin-api": "bun run scripts/gen-plugin-api-doc.ts",
    "bump": "bun run scripts/bump.ts",
    "bump:ipc": "bun run scripts/bump-protocol.ts ipc",
    "bump:terminal_manager": "bun run scripts/bump-protocol.ts terminal-manager"
  },
  "dependencies": {
    "@brimveyn/aimux-config": "workspace:*",
    "@brimveyn/aimux-plugin": "workspace:*",
    "@opentui/core": "^0.6.6",
    "@opentui/react": "^0.6.6",
    "@resvg/resvg-wasm": "^2.6.2",
    "@xterm/headless": "^6.0.0",
    "bun-pty": "^0.5.1",
    "marked": "^18.1.1",
    "react": "^19.3.1",
    "shiki": "^4.5.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "knip": "^6.42.1",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
